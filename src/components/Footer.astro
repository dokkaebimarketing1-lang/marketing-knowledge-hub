---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import SourceList from './SourceList.astro';

/**
 * Starlight Footer 오버라이드 컴포넌트.
 * `astro.config`의 `components.Footer`에 등록하면 문서 하단의 기본 푸터
 * 앞에 현재 문서의 출처 인용 목록을 렌더링한다.
 *
 * - `Astro.locals.starlightRoute.entry.data.sourceIds`를 type-safe하게 읽는다
 *   (문서 메타 계약에서 sourceIds는 항상 string[]로 보장된다).
 * - 출처가 없는 문서(utility 등)는 SourceList가 아무것도 렌더링하지 않으므로
 *   기본 푸터만 남는다. 목록이 중복으로 렌더링되지 않는다.
 */
const sourceIds = Astro.locals.starlightRoute.entry.data.sourceIds ?? [];
---

<SourceList sourceIds={sourceIds} />
<DefaultFooter />
